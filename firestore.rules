rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Global campaign statistics: public read, allow atomic increment
    match /justice_stats/{statId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Supporter entries: public read to verify status, create once (immutable)
    match /supporters/{supporterId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
